{
  "data": "data",
  "output": "_output",
  "video_extensions": [
    ".mp4",
    ".mov",
    ".avi",
    ".mkv",
    ".m4v"
  ],
  "cities_analyse": [],
  "always_analyse": false,
  "tracking_model": "yolo11x.pt",
  "bbox_tracker": "bbox_custom_tracker.yaml",
  "track_buffer_sec": 2,
  "min_confidence": 0.7,
  "yolo_imgsz": 640,
  "device": "auto",
  "half_precision": false,
  "runs_root": "runs",
  "delete_runs_files": true,
  "save_annotated_video": false,
  "display_frame_tracking": false,
  "cpu_worker": 4,
  "boundary_left": 0.45,
  "boundary_right": 0.55,
  "check_per_sec_time": 3,
  "crossing_rule": "road_crossing",
  "use_segmentation": true,
  "segmentation_is_primary": true,
  "segmentation_model": "nvidia/segformer-b2-finetuned-cityscapes-1024-1024",
  "segmentation_device": "auto",
  "segmentation_parallel_videos": 2,
  "segmentation_batch_size": 8,
  "segmentation_input_width": 1024,
  "segmentation_input_height": 512,
  "segmentation_min_confidence": 0.5,
  "segmentation_coarse_hz": 1,
  "segmentation_refine_hz": 4,
  "seg_data": "_output/segmentation",
  "processing_fps": null,
  "ftp_base_url": "",
  "min_waiting_time": 0,
  "max_waiting_time": 1e+20,
  "min_speed_limit": 0.3,
  "max_speed_limit": 3.5,
  "font_family": "Open Sans, verdana, arial, sans-serif",
  "font_size": 18,
  "plotly_template": "plotly_white",
  "save_images": true,
  "open_figures": true,
  "logger_level": "info",
  "git_pull": false,
  "email_send": false,
  "email_sender": "",
  "email_recipients": []
}
